generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CASHIER
  KITCHEN
  MANAGER
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  FINISHED
  COMPLETED
  CANCELLED
}

enum TenderType {
  CASH
  CARD
  SPLIT
}

enum PaidStatus {
  UNPAID
  PAID
  REFUNDED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  role            Role             @default(CASHIER)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ordersPlaced    Order[]          @relation("OrderPlacedBy")
  ordersCancelled Order[]          @relation("OrderCancelledBy")
  ordersFinished  Order[]          @relation("OrderFinishedBy")
  ordersCompleted Order[]          @relation("OrderCompletedBy")
  ordersRefunded  Order[]          @relation("OrderRefundedBy")
  orderStatusLogs OrderStatusLog[]
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}

model Category {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

model MenuItem {
  id            String           @id @default(cuid())
  itemNumber    String?
  name          String
  description   String?
  price       Decimal          @db.Decimal(10, 2)
  sortOrder   Int              @default(0)
  isAvailable Boolean          @default(true)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options     MenuItemOption[]
  sizes       MenuItemSize[]
  orderItems  OrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId, isAvailable, sortOrder])
}

model MenuItemOption {
  id          String   @id @default(cuid())
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name        String
  priceDelta  Decimal  @default(0) @db.Decimal(10, 2)
  optionGroup String?
  sortOrder   Int      @default(0)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([menuItemId, isAvailable, sortOrder])
}

model MenuItemSize {
  id          String   @id @default(cuid())
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name        String
  priceDelta  Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([menuItemId, isAvailable, sortOrder])
}

model Order {
  id             String           @id @default(cuid())
  ticketNumber   Int
  businessDate   String
  status         OrderStatus      @default(PENDING)
  previousStatus OrderStatus?
  payAtPickup    Boolean          @default(false)
  tenderType     TenderType?
  paidStatus     PaidStatus       @default(UNPAID)
  cardAmount           Decimal?         @db.Decimal(10, 2)
  cashAmount           Decimal?         @db.Decimal(10, 2)
  refundTenderType     TenderType?
  refundedCardAmount   Decimal?         @db.Decimal(10, 2)
  refundedCashAmount   Decimal?         @db.Decimal(10, 2)
  refundedAt           DateTime?
  refundedById         String?
  refundedBy           User?            @relation("OrderRefundedBy", fields: [refundedById], references: [id])
  cancelReason         String?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelledBy    User?            @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  finishedAt     DateTime?
  finishedById   String?
  finishedBy     User?            @relation("OrderFinishedBy", fields: [finishedById], references: [id])
  completedAt    DateTime?
  completedById  String?
  completedBy    User?            @relation("OrderCompletedBy", fields: [completedById], references: [id])
  placedById     String
  placedBy       User             @relation("OrderPlacedBy", fields: [placedById], references: [id])
  items          OrderItem[]
  statusLogs     OrderStatusLog[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([businessDate, ticketNumber])
  @@index([businessDate], map: "Order_businessDate_idx")
  @@index([businessDate, status, createdAt])
  @@index([businessDate, status, ticketNumber])
}

model AppSetting {
  key   String @id
  value String
}

model OrderItem {
  id         String            @id @default(cuid())
  orderId    String
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemCode   String?
  name       String
  sizeName   String?
  price      Decimal           @db.Decimal(10, 2)
  quantity    Int               @default(1)
  preferences String?
  options     OrderItemOption[]
  @@index([orderId], map: "OrderItem_orderId_idx")
}

model OrderItemOption {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  name        String
  priceDelta  Decimal   @db.Decimal(10, 2)
  @@index([orderItemId])
}

model OrderStatusLog {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String
  changedBy   User         @relation(fields: [changedById], references: [id])
  createdAt   DateTime     @default(now())
  @@index([orderId])
}
